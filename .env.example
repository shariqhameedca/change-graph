DATABASE_URL=postgresql+psycopg://changegraph:changegraph@localhost:5432/changegraph

# mock (default, no AWS needed) or bedrock
LLM_PROVIDER=mock

# Required only when LLM_PROVIDER=bedrock. Many Claude models on Bedrock
# require the cross-region inference profile ID (the "us." prefix), not the
# bare model ID -- e.g. us.anthropic.claude-sonnet-4-5-20250929-v1:0.
# Run `aws bedrock list-foundation-models` to see what your account can use.
AWS_REGION=
BEDROCK_MODEL_ID=

# Standard AWS credential env vars, only needed for LLM_PROVIDER=bedrock.
# boto3 also honors ~/.aws/credentials or an instance role if you prefer
# not to put keys in this file.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
